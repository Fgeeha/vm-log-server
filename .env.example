# =============================================================================
# VM Log Server — Конфигурация подключения к Synology NAS
# =============================================================================
# Скопируйте этот файл: cp .env.example .env
# Заполните значения под вашу среду, затем запустите: node server.js
# =============================================================================

# -----------------------------------------------------------------------------
# SYNOLOGY NAS — основные параметры подключения
# -----------------------------------------------------------------------------

# IP-адрес или hostname вашего Synology NAS
SYNOLOGY_HOST=192.168.1.100

# Порт DSM Web API (по умолчанию 5000 для HTTP, 5001 для HTTPS)
SYNOLOGY_PORT=5000

# Использовать HTTPS? (true / false)
SYNOLOGY_HTTPS=false

# Учётные данные администратора DSM
# Рекомендуется создать отдельного пользователя только с правами чтения логов
SYNOLOGY_USER=admin
SYNOLOGY_PASSWORD=your_password_here

# Путь к общей папке с экспортированными CSV-логами (SMB/CIFS)
# Пример Linux mount: /mnt/nas/logs
# Пример Windows:     Z:\logs
# Пример локально:    ./logs/nas_log.csv
NAS_CSV_PATH=./logs/nas_log.csv

# Имя общей папки на NAS для автомонтирования (опционально)
NAS_SHARE_NAME=logs

# -----------------------------------------------------------------------------
# SYSLOG — приём логов в реальном времени
# -----------------------------------------------------------------------------

# UDP порт для приёма Syslog от DSM Log Center
# DSM настройка: Log Center → Log Sending → UDP → этот порт
# Порт 514 требует sudo/root; для запуска без root используйте 5514
# и настройте iptables (см. README)
SYSLOG_PORT=514

# IP-адрес на котором слушать (0.0.0.0 = все интерфейсы)
SYSLOG_HOST=0.0.0.0

# Формат syslog от Synology: ietf или bsd
# DSM: Log Center → Log Sending → Format → IETF (RFC 5424)
SYSLOG_FORMAT=ietf

# -----------------------------------------------------------------------------
# CSV POLLING — периодическое чтение файла логов
# -----------------------------------------------------------------------------

# Включить polling (true / false)
POLL_ENABLED=true

# Интервал опроса в миллисекундах (30000 = 30 секунд)
POLL_INTERVAL_MS=30000

# Кодировка CSV-файла от Synology (обычно utf8 или cp1251 для кириллицы)
POLL_CSV_ENCODING=utf8

# -----------------------------------------------------------------------------
# HTTP / WEBSOCKET СЕРВЕР
# -----------------------------------------------------------------------------

# Порт HTTP-сервера и WebSocket
HTTP_PORT=3000

# Разрешённые источники CORS (через запятую, или * для всех)
CORS_ORIGIN=*

# Максимум событий в памяти (ring buffer)
MAX_EVENTS=10000

# -----------------------------------------------------------------------------
# БЕЗОПАСНОСТЬ (опционально)
# -----------------------------------------------------------------------------

# API токен для защиты эндпоинтов (оставьте пустым для отключения)
API_TOKEN=

# Разрешённые IP для подключения к WebSocket (через запятую, или * для всех)
# Пример: 192.168.1.0/24,10.0.0.1
ALLOWED_IPS=*

# -----------------------------------------------------------------------------
# ЛОГИРОВАНИЕ
# -----------------------------------------------------------------------------

# Уровень логов: debug | info | warn | error
LOG_LEVEL=info

# Записывать логи в файл (оставьте пустым для отключения)
LOG_FILE=./logs/server.log
